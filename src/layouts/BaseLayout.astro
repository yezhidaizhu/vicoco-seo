---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  lang?: string;
  openGraphDescription?: string;
  openGraphLocale?: string;
  skipLinkLabel?: string;
  alternates?: Array<{ hrefLang: string; href: string }>;
  structuredData?: Record<string, unknown>;
  robots?: string;
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt = 'Vicoco image compression editor comparing an original and compressed image',
  lang = 'en',
  openGraphDescription = description,
  openGraphLocale,
  skipLinkLabel = 'Skip to content',
  alternates = [],
  structuredData,
  robots = 'index, follow, max-image-preview:large',
} = Astro.props;
const isProduction = import.meta.env.PROD;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hrefLang} href={alternate.href} />
      ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vicoco" />
    {openGraphLocale && <meta property="og:locale" content={openGraphLocale} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={openGraphDescription} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={openGraphDescription} />
    {image && <meta name="twitter:image" content={image} />}
    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    {isProduction && (
      <Fragment>
        <script
          is:inline
          async
          src="https://www.googletagmanager.com/gtag/js?id=G-YS3QJJ1B9D"
        ></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', 'G-YS3QJJ1B9D');
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLinkLabel}</a>
    <slot />
  </body>
</html>
