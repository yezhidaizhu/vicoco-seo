---
import type { ToolPageData } from '../../data/toolPages';

interface Props {
  page: Extract<ToolPageData, { kind: 'general-compressor' }>;
}

const { page } = Astro.props;
const { content } = page;
const formatCodes = ['JPG', 'PNG', 'WebP'];
---

<section class="general-goals" aria-labelledby="general-goals-title">
  <div class="container goal-layout">
    <div class="goal-copy">
      <h2 id="general-goals-title">{content.formatHeading}</h2>
      <p>{content.formatBody}</p>
    </div>

    <div class="format-directory">
      {content.formats.map((format, index) => (
        <article>
          <span>{formatCodes[index] ?? `0${index + 1}`}</span>
          <div><h3>{format.title}</h3><p>{format.body}</p></div>
          <i aria-hidden="true">{index === 0 ? 'Q' : index === 1 ? 'α' : 'WEB'}</i>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="general-workflow" aria-labelledby="general-workflow-title">
  <div class="container workflow-shell">
    <h2 id="general-workflow-title">{content.workflowHeading}</h2>
    <ol>
      {content.workflow.map((step, index) => (
        <li>
          <div class="workflow-number">{String(index + 1).padStart(2, '0')}</div>
          <div class="workflow-copy"><h3>{step.title}</h3><p>{step.body}</p></div>
          <div class={`workflow-glyph glyph-${index}`} aria-hidden="true"><span></span></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="general-review" aria-labelledby="general-review-title">
  <div class="container review-shell">
    <div class="review-copy">
      <h2 id="general-review-title">{content.reviewHeading}</h2>
      <p>{content.reviewBody}</p>
    </div>

    <div class="review-board">
      <div class="review-preview" aria-hidden="true"><span>ORIGINAL</span><i></i><span>RESULT</span></div>
      <div class="review-stats">
        <span><small>Format</small><strong>WebP</strong></span>
        <span><small>Quality</small><strong>78</strong></span>
        <span><small>Change</small><strong>−46%</strong></span>
      </div>
    </div>

    <div class="batch-ledger">
      <header><h3>{content.batchHeading}</h3><p>{content.batchBody}</p></header>
      <ul>{content.batchRules.map((rule) => <li><strong>{rule.title}</strong><span>{rule.body}</span></li>)}</ul>
    </div>

    <aside class="general-local">
      <h3>{content.localHeading}</h3>
      <p>{content.localBody}</p>
      <ul>{content.localFacts.map((fact) => <li>{fact}</li>)}</ul>
    </aside>
  </div>
</section>

<style>
  .general-goals,
  .general-workflow,
  .general-review {
    padding: 80px 0;
  }

  .goal-layout {
    display: grid;
    grid-template-columns: minmax(240px, 0.75fr) minmax(0, 1.25fr);
    gap: 88px;
  }

  .goal-copy > p:last-child,
  .format-directory p,
  .workflow-copy p,
  .review-copy p,
  .batch-ledger p,
  .batch-ledger li span,
  .general-local p {
    margin: 0;
    color: var(--muted);
  }

  .format-directory article {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: 22px;
    align-items: start;
    padding: 0 0 32px;
  }

  .format-directory article > span {
    display: grid;
    width: 64px;
    height: 64px;
    place-items: center;
    border: 2px solid var(--text);
    color: var(--brand-text);
    font-size: 11px;
    font-weight: 900;
  }

  .format-directory h3 {
    margin-bottom: 8px;
  }

  .format-directory i {
    color: var(--muted);
    font-size: 10px;
    font-style: normal;
    font-weight: 850;
  }

  .workflow-shell > h2 {
    max-width: 620px;
  }

  .workflow-shell ol {
    padding: 0;
    margin: 48px 0 0;
    list-style: none;
  }

  .workflow-shell li {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) 160px;
    gap: 28px;
    align-items: center;
    min-height: 150px;
  }

  .workflow-shell li:nth-child(even) .workflow-number {
    grid-column: 3;
    grid-row: 1;
  }

  .workflow-shell li:nth-child(even) .workflow-copy {
    grid-column: 2;
    grid-row: 1;
    text-align: right;
  }

  .workflow-shell li:nth-child(even) .workflow-glyph {
    grid-column: 1;
    grid-row: 1;
  }

  .workflow-number {
    color: var(--brand-text);
    font-size: 24px;
    font-weight: 900;
  }

  .workflow-copy h3 {
    margin-bottom: 8px;
  }

  .workflow-glyph {
    display: grid;
    width: 160px;
    height: 96px;
    place-items: center;
    border: 1px solid var(--rule);
  }

  .workflow-glyph span {
    display: block;
    width: 74px;
    height: 52px;
    border: 2px solid var(--text);
    box-shadow: 12px 12px 0 var(--brand);
  }

  .glyph-1 span {
    width: 92px;
    box-shadow: inset 0 -18px var(--brand);
  }

  .glyph-2 span {
    width: 54px;
    box-shadow: 20px 0 0 var(--brand);
  }

  .review-copy {
    max-width: 680px;
  }

  .review-board {
    margin-top: 44px;
    border: 2px solid var(--text);
  }

  .review-preview {
    display: grid;
    grid-template-columns: 1fr 2px 1fr;
    height: 220px;
    align-items: center;
    justify-items: center;
    background-image: linear-gradient(45deg, var(--surface) 25%, transparent 25%), linear-gradient(-45deg, var(--surface) 25%, transparent 25%), linear-gradient(45deg, transparent 75%, var(--surface) 75%), linear-gradient(-45deg, transparent 75%, var(--surface) 75%);
    background-position: 0 0, 0 10px, 10px -10px, -10px 0;
    background-size: 20px 20px;
  }

  .review-preview i {
    width: 2px;
    height: 100%;
    background: var(--brand);
  }

  .review-preview span {
    padding: 8px 10px;
    background: #fff;
    font-size: 10px;
    font-weight: 900;
  }

  .review-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--text);
  }

  .review-stats span {
    padding: 18px;
  }

  .review-stats span + span {
    border-left: 1px solid var(--rule);
  }

  .review-stats small,
  .review-stats strong {
    display: block;
  }

  .review-stats small {
    color: var(--muted);
  }

  .review-stats strong {
    margin-top: 4px;
  }

  .batch-ledger {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    margin-top: 52px;
  }

  .batch-ledger ul,
  .general-local ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .batch-ledger li {
    display: grid;
    gap: 5px;
    padding-bottom: 20px;
  }

  .general-local {
    margin-top: 56px;
    padding-left: 22px;
    border-left: 4px solid var(--brand);
  }

  .general-local ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 18px;
    font-weight: 750;
  }

  @media (max-width: 760px) {
    .general-goals,
    .general-workflow,
    .general-review {
      padding: 64px 0;
    }

    .goal-layout,
    .batch-ledger {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .workflow-shell li,
    .workflow-shell li:nth-child(even) {
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 16px;
      min-height: auto;
      padding-bottom: 36px;
    }

    .workflow-shell li .workflow-number,
    .workflow-shell li:nth-child(even) .workflow-number {
      grid-column: 1;
      grid-row: 1;
    }

    .workflow-shell li .workflow-copy,
    .workflow-shell li:nth-child(even) .workflow-copy {
      grid-column: 2;
      grid-row: 1;
      text-align: left;
    }

    .workflow-glyph {
      display: none;
    }

    .review-preview {
      height: 170px;
    }

    .review-stats {
      grid-template-columns: 1fr;
    }

    .review-stats span + span {
      border-top: 1px solid var(--rule);
      border-left: 0;
    }
  }
</style>
