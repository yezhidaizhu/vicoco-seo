---
import type { ToolPageData } from '../../data/toolPages';

interface Props {
  page: Extract<ToolPageData, { kind: 'png-compressor' }>;
}

const { page } = Astro.props;
const { content } = page;
const checkerCells = Array.from({ length: 24 });
---

<section class="alpha-inspector" aria-labelledby="alpha-inspector-title">
  <div class="container alpha-layout">
    <div class="alpha-copy">
      <h2 id="alpha-inspector-title">{content.transparencyHeading}</h2>
      <p>{content.transparencyBody}</p>
    </div>

    <div class="alpha-stage" aria-label="Transparent PNG before and after comparison">
      <div class="alpha-view">
        <header><span>ORIGINAL</span><strong>RGBA</strong></header>
        <div class="checker-grid" aria-hidden="true">
          {checkerCells.map((_, index) => <i class={index % 2 === Math.floor(index / 6) % 2 ? 'dark' : undefined}></i>)}
          <b class="alpha-shape alpha-shape-original"></b>
        </div>
      </div>
      <div class="alpha-view">
        <header><span>RESULT</span><strong>ALPHA OK</strong></header>
        <div class="checker-grid" aria-hidden="true">
          {checkerCells.map((_, index) => <i class={index % 2 === Math.floor(index / 6) % 2 ? 'dark' : undefined}></i>)}
          <b class="alpha-shape alpha-shape-result"></b>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="png-controls" aria-labelledby="png-controls-title">
  <div class="container">
    <header>
      <h2 id="png-controls-title">{content.paletteHeading}</h2>
      <p>{content.paletteBody}</p>
    </header>

    <div class="control-board">
      {content.paletteControls.map((control, index) => (
        <article>
          <div class={`control-readout readout-${index}`} aria-hidden="true">
            <span>{index === 0 ? '64' : index === 1 ? '72%' : 'ON'}</span>
            <i><b></b></i>
          </div>
          <h3>{control.title}</h3>
          <p>{control.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="png-route" aria-labelledby="png-route-title">
  <div class="container png-route-layout">
    <div>
      <h2 id="png-route-title">{content.workflowHeading}</h2>
    </div>
    <ol>
      {content.workflow.map((step, index) => (
        <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>
      ))}
    </ol>
  </div>
</section>

<section class="png-batch" aria-labelledby="png-batch-title">
  <div class="container png-batch-layout">
    <div class="batch-meter" aria-label="PNG file size factors">
      <header><span>PNG OUTPUT</span><strong>QUEUE 03</strong></header>
      {content.sizeFactors.map((factor, index) => (
        <div class="meter-row">
          <div><strong>{factor.title}</strong><small>{factor.body}</small></div>
          <i aria-hidden="true"><b style={`--meter:${84 - index * 21}%`}></b></i>
        </div>
      ))}
    </div>
    <div class="batch-copy">
      <h2 id="png-batch-title">{content.batchHeading}</h2>
      <p>{content.batchBody}</p>
      <aside>
        <h3>{content.localHeading}</h3>
        <p>{content.localBody}</p>
        <ul>{content.localFacts.map((fact) => <li>{fact}</li>)}</ul>
      </aside>
    </div>
  </div>
</section>

<section class="png-cta" aria-labelledby="png-cta-title">
  <div class="container png-cta-layout">
    <div><h2 id="png-cta-title">{page.ctaHeading}</h2><p>{page.ctaBody}</p></div>
    <button class="button-primary" data-choose-images type="button">{page.ctaButton}</button>
  </div>
</section>

<style>
  .alpha-inspector,
  .png-controls,
  .png-route,
  .png-batch,
  .png-cta {
    padding: 80px 0;
  }

  .alpha-layout,
  .png-route-layout,
  .png-batch-layout,
  .png-cta-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: 72px;
    align-items: center;
  }

  .alpha-copy > p:last-child,
  .png-controls header > p:last-child,
  .control-board p,
  .png-route li p,
  .batch-copy > p,
  .batch-copy aside p,
  .png-cta p {
    color: var(--muted);
  }

  .alpha-stage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 2px solid var(--text);
  }

  .alpha-view + .alpha-view {
    border-left: 1px solid var(--text);
  }

  .alpha-view header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--text);
    font-size: 10px;
  }

  .alpha-view header strong {
    color: var(--brand-text);
  }

  .checker-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    min-height: 260px;
  }

  .checker-grid i {
    background: var(--page);
  }

  .checker-grid i.dark {
    background: var(--rule);
  }

  .alpha-shape {
    position: absolute;
    inset: 18% 16%;
    background: var(--brand);
    clip-path: polygon(8% 82%, 22% 35%, 42% 52%, 64% 18%, 94% 64%, 88% 88%, 12% 88%);
  }

  .alpha-shape-original {
    opacity: 0.82;
  }

  .alpha-shape-result {
    inset: 22% 20%;
  }

  .png-controls {
    background: var(--surface);
  }

  .png-controls header {
    max-width: 720px;
  }

  .control-board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 48px;
    border-top: 2px solid var(--text);
  }

  .control-board article {
    padding: 28px;
  }

  .control-board article + article {
    border-left: 1px solid var(--rule);
  }

  .control-readout {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: center;
    min-height: 64px;
    margin-bottom: 48px;
  }

  .control-readout > span {
    min-width: 54px;
    color: var(--brand-text);
    font-size: 24px;
    font-weight: 900;
  }

  .control-readout i {
    height: 10px;
    border: 1px solid var(--text);
    background: var(--page);
  }

  .control-readout i b {
    display: block;
    width: 64%;
    height: 100%;
    background: var(--brand);
  }

  .readout-1 i b {
    width: 72%;
  }

  .readout-2 i b {
    width: 100%;
  }

  .control-board h3 {
    margin-bottom: 8px;
  }

  .control-board p {
    margin: 0;
  }

  .png-route-layout {
    align-items: start;
  }

  .png-route ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .png-route li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 20px;
    padding: 24px 0;
    border-top: 1px solid var(--rule);
  }

  .png-route li > span {
    color: var(--brand-text);
    font-size: 18px;
    font-weight: 900;
  }

  .png-route li h3 {
    margin-bottom: 8px;
  }

  .png-route li p {
    margin: 0;
  }

  .png-batch {
    background: var(--surface);
  }

  .png-batch-layout {
    grid-template-columns: minmax(0, 1.14fr) minmax(300px, 0.86fr);
  }

  .batch-meter {
    border: 2px solid var(--text);
    background: var(--page);
  }

  .batch-meter > header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--text);
    font-size: 11px;
  }

  .meter-row {
    display: grid;
    grid-template-columns: minmax(180px, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: center;
    padding: 22px 20px;
  }

  .meter-row + .meter-row {
    border-top: 1px solid var(--rule);
  }

  .meter-row strong,
  .meter-row small {
    display: block;
  }

  .meter-row small {
    margin-top: 6px;
    color: var(--muted);
  }

  .meter-row > i {
    height: 12px;
    border: 1px solid var(--text);
  }

  .meter-row > i b {
    display: block;
    width: var(--meter);
    height: 100%;
    background: var(--brand);
  }

  .batch-copy aside {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 4px solid var(--brand);
  }

  .batch-copy aside ul {
    padding-left: 20px;
    margin-bottom: 0;
  }

  .png-cta-layout {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .png-cta .button-primary {
    min-width: 250px;
  }

  @media (max-width: 820px) {
    .alpha-layout,
    .png-route-layout,
    .png-batch-layout,
    .png-cta-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .control-board {
      grid-template-columns: 1fr;
    }

    .control-board article + article {
      border-top: 1px solid var(--rule);
      border-left: 0;
    }

    .control-readout {
      margin-bottom: 24px;
    }

    .png-cta .button-primary {
      width: 100%;
    }
  }

  @media (max-width: 560px) {
    .alpha-inspector,
    .png-controls,
    .png-route,
    .png-batch,
    .png-cta {
      padding: 64px 0;
    }

    .alpha-stage {
      grid-template-columns: 1fr;
    }

    .alpha-view + .alpha-view {
      border-top: 1px solid var(--text);
      border-left: 0;
    }

    .checker-grid {
      min-height: 210px;
    }

    .meter-row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
