---
import type { ToolPageData } from '../../data/toolPages';

interface Props {
  page: Extract<ToolPageData, { kind: 'checker' }>;
}

const { page } = Astro.props;
const { content } = page;
const sampleValues = ['2.4 MB', '1920 × 1080', 'JPEG'];
---

<section class="checker-report" aria-labelledby="checker-report-title">
  <div class="container">
    <div class="report-copy">
      <h2 id="checker-report-title">{content.reportHeading}</h2>
      <p>{content.reportBody}</p>
    </div>

    <div class="file-report">
      <header>
        <span class="file-glyph" aria-hidden="true"></span>
        <div><strong>image.jpg</strong><small>JPEG · RGB</small></div>
        <span class="report-status">READY</span>
      </header>
      <dl>
        {content.metrics.map((metric, index) => (
          <div>
            <dt>{metric.title}</dt>
            <dd>{sampleValues[index] ?? '—'}</dd>
            <p>{metric.body}</p>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<section class="checker-reading" aria-labelledby="checker-reading-title">
  <div class="container reading-layout">
    <div class="reading-title">
      <h2 id="checker-reading-title">{content.readingHeading}</h2>
    </div>
    <ol>
      {content.readingSteps.map((step, index) => (
        <li>
          <span>{index + 1}</span>
          <div><h3>{step.title}</h3><p>{step.body}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="checker-interpret" aria-labelledby="checker-interpret-title">
  <div class="container interpret-shell">
    <div class="interpret-copy">
      <h2 id="checker-interpret-title">{content.comparisonHeading}</h2>
      <p>{content.comparisonBody}</p>
      <div class="delta-readout" aria-label="Example image details">
        <span><small>Format</small><strong>JPEG</strong></span>
        <b>16:9</b>
        <span><small>Dimensions</small><strong>1920 × 1080</strong></span>
      </div>
    </div>

    <div class="queue-sheet">
      <h3>{content.queueHeading}</h3>
      <p>{content.queueBody}</p>
      <dl>
        {content.queueFields.map((field) => <div><dt>{field.title}</dt><dd>{field.body}</dd></div>)}
      </dl>
    </div>

    <aside class="checker-local">
      <h3>{content.localHeading}</h3>
      <p>{content.localBody}</p>
      <ul>{content.localFacts.map((fact) => <li>{fact}</li>)}</ul>
    </aside>
  </div>
</section>

<style>
  .checker-report,
  .checker-reading,
  .checker-interpret {
    padding: 80px 0;
  }

  .report-copy {
    max-width: 860px;
    margin-inline: auto;
  }

  .report-copy p,
  .reading-layout p,
  .interpret-copy > p,
  .queue-sheet > p,
  .checker-local p {
    margin: 0;
    color: var(--muted);
  }

  .file-report {
    margin: 48px auto 0;
    border: 2px solid var(--text);
  }

  .file-report header {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--text);
  }

  .file-glyph {
    width: 44px;
    height: 44px;
    border: 2px solid var(--brand);
    background: linear-gradient(135deg, transparent 52%, var(--brand) 53% 60%, transparent 61%);
  }

  .file-report header small {
    display: block;
    margin-top: 3px;
    color: var(--muted);
  }

  .report-status {
    color: var(--brand-text);
    font-size: 11px;
    font-weight: 900;
  }

  .file-report dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }

  .file-report dl > div {
    min-width: 0;
    padding: 28px 24px;
  }

  .file-report dl > div + div {
    border-left: 1px solid var(--rule);
  }

  .file-report dt {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .file-report dd {
    margin: 10px 0 18px;
    font-size: clamp(25px, 4vw, 38px);
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  .file-report dl p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .reading-layout {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
    gap: 96px;
  }

  .reading-layout ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .reading-layout li {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 20px;
    padding-bottom: 36px;
  }

  .reading-layout li > span {
    color: var(--brand-text);
    font-weight: 900;
  }

  .reading-layout h3 {
    margin-bottom: 8px;
  }

  .interpret-shell {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px;
  }

  .delta-readout {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 18px;
    align-items: center;
    margin-top: 36px;
  }

  .delta-readout span {
    padding: 18px;
    border: 1px solid var(--text);
  }

  .delta-readout small,
  .delta-readout strong {
    display: block;
  }

  .delta-readout small {
    color: var(--muted);
  }

  .delta-readout strong {
    margin-top: 6px;
    font-size: 22px;
  }

  .delta-readout b {
    color: var(--brand-text);
    font-size: 13px;
  }

  .queue-sheet {
    padding-top: 6px;
  }

  .queue-sheet dl {
    margin: 30px 0 0;
  }

  .queue-sheet dl > div {
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }

  .queue-sheet dt {
    font-weight: 850;
  }

  .queue-sheet dd {
    margin: 5px 0 0;
    color: var(--muted);
  }

  .checker-local {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 24px 48px;
    padding-left: 22px;
    border-left: 4px solid var(--brand);
  }

  .checker-local ul {
    display: flex;
    flex-wrap: wrap;
    grid-column: 2;
    gap: 8px 20px;
    padding: 0;
    margin: 0;
    list-style: none;
    font-weight: 750;
  }

  @media (max-width: 760px) {
    .checker-report,
    .checker-reading,
    .checker-interpret {
      padding: 64px 0;
    }

    .file-report dl,
    .reading-layout,
    .interpret-shell,
    .checker-local {
      grid-template-columns: 1fr;
    }

    .file-report dl > div + div {
      border-top: 1px solid var(--rule);
      border-left: 0;
    }

    .reading-layout,
    .interpret-shell {
      gap: 40px;
    }

    .delta-readout {
      grid-template-columns: 1fr;
    }

    .delta-readout b {
      text-align: center;
    }

    .checker-local ul {
      grid-column: 1;
    }
  }
</style>
