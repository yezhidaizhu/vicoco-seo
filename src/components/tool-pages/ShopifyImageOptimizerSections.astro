---
import type { ToolPageData } from '../../data/toolPages';

interface Props {
  page: Extract<ToolPageData, { kind: 'general-compressor' }>;
}

const { page } = Astro.props;
const { content } = page;
---

<section class="shopify-spec" aria-labelledby="shopify-spec-title">
  <div class="container shopify-spec-layout">
    <header>
      <h2 id="shopify-spec-title">{content.formatHeading}</h2>
      <p>{content.formatBody}</p>
    </header>

    <div class="catalog-sheet" aria-label="Product image output plan">
      <div class="catalog-preview" aria-hidden="true">
        <div class="product-frame"><span></span></div>
        <strong>2048 x 2048</strong>
        <small>square product image</small>
      </div>
      <dl>
        {content.formats.map((item, index) => (
          <div>
            <dt><span>0{index + 1}</span>{item.title}</dt>
            <dd>{item.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<section class="shopify-workflow" aria-labelledby="shopify-workflow-title">
  <div class="container">
    <div class="workflow-heading">
      <h2 id="shopify-workflow-title">{content.workflowHeading}</h2>
    </div>
    <ol>
      {content.workflow.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div><h3>{step.title}</h3><p>{step.body}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="shopify-batch" aria-labelledby="shopify-batch-title">
  <div class="container batch-layout">
    <div class="queue-panel" aria-label="Product image batch preview">
      <header>
        <span>PRODUCT SET</span>
        <strong>04 files</strong>
      </header>
      <div class="queue-row queue-row-active"><i></i><span>front-view.jpg</span><b>READY</b></div>
      <div class="queue-row"><i></i><span>detail-view.jpg</span><b>READY</b></div>
      <div class="queue-row"><i></i><span>side-view.jpg</span><b>READY</b></div>
      <div class="queue-summary">
        <span><small>FORMAT</small><strong>WebP</strong></span>
        <span><small>QUALITY</small><strong>78</strong></span>
        <span><small>EXPORT</small><strong>ZIP</strong></span>
      </div>
    </div>

    <div class="batch-copy">
      <h2 id="shopify-batch-title">{content.batchHeading}</h2>
      <p>{content.batchBody}</p>
      <ul>
        {content.batchRules.map((rule) => (
          <li><h3>{rule.title}</h3><p>{rule.body}</p></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="shopify-review" aria-labelledby="shopify-review-title">
  <div class="container review-layout">
    <div>
      <h2 id="shopify-review-title">{content.reviewHeading}</h2>
      <p>{content.reviewBody}</p>
    </div>
    <aside>
      <h3>{content.localHeading}</h3>
      <p>{content.localBody}</p>
      <ul>{content.localFacts.map((fact) => <li>{fact}</li>)}</ul>
    </aside>
  </div>
</section>

<section class="shopify-cta" aria-labelledby="shopify-cta-title">
  <div class="container shopify-cta-layout">
    <div>
      <h2 id="shopify-cta-title">{page.ctaHeading}</h2>
      <p>{page.ctaBody}</p>
    </div>
    <button class="button-primary" data-choose-images type="button">{page.ctaButton}</button>
  </div>
</section>

<style>
  .shopify-spec,
  .shopify-workflow,
  .shopify-batch,
  .shopify-review,
  .shopify-cta {
    padding: 80px 0;
  }

  .shopify-spec-layout,
  .batch-layout,
  .review-layout,
  .shopify-cta-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 72px;
    align-items: start;
  }

  .shopify-spec header > p:last-child,
  .workflow-heading + ol p,
  .batch-copy > p,
  .batch-copy li p,
  .shopify-review p,
  .shopify-cta p {
    color: var(--muted);
  }

  .catalog-sheet,
  .queue-panel {
    border: 2px solid var(--text);
    background: var(--page);
  }

  .catalog-preview {
    display: grid;
    grid-template-columns: 144px 1fr;
    gap: 4px 24px;
    align-items: center;
    padding: 24px;
    border-bottom: 1px solid var(--rule);
  }

  .product-frame {
    grid-row: 1 / 3;
    aspect-ratio: 1;
    padding: 18px;
    background: var(--surface);
  }

  .product-frame span {
    display: block;
    width: 100%;
    height: 100%;
    border: 2px solid var(--text);
    background: var(--brand);
    clip-path: polygon(18% 74%, 26% 36%, 47% 20%, 76% 33%, 84% 74%);
  }

  .catalog-preview strong {
    align-self: end;
    font-size: 22px;
  }

  .catalog-preview small {
    align-self: start;
    color: var(--muted);
  }

  .catalog-sheet dl {
    margin: 0;
  }

  .catalog-sheet dl > div {
    display: grid;
    grid-template-columns: minmax(180px, 0.72fr) minmax(0, 1.28fr);
    gap: 24px;
    padding: 22px 24px;
  }

  .catalog-sheet dl > div + div {
    border-top: 1px solid var(--rule);
  }

  .catalog-sheet dt {
    font-weight: 800;
  }

  .catalog-sheet dt span {
    margin-right: 12px;
    color: var(--brand-text);
    font-size: 11px;
  }

  .catalog-sheet dd {
    margin: 0;
    color: var(--muted);
  }

  .shopify-workflow {
    background: var(--surface);
  }

  .workflow-heading {
    max-width: 720px;
  }

  .shopify-workflow ol {
    padding: 0;
    margin: 48px 0 0;
    list-style: none;
  }

  .shopify-workflow li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 28px;
    padding: 28px 0;
    border-top: 1px solid var(--rule);
  }

  .shopify-workflow li > span {
    color: var(--brand-text);
    font-size: 24px;
    font-weight: 900;
  }

  .shopify-workflow h3,
  .batch-copy h3 {
    margin-bottom: 8px;
  }

  .shopify-workflow p,
  .batch-copy p {
    margin: 0;
  }

  .batch-layout {
    grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
    align-items: center;
  }

  .queue-panel > header,
  .queue-row,
  .queue-summary {
    display: grid;
    align-items: center;
  }

  .queue-panel > header {
    grid-template-columns: 1fr auto;
    padding: 18px 22px;
    border-bottom: 1px solid var(--text);
    font-size: 12px;
  }

  .queue-row {
    grid-template-columns: 40px 1fr auto;
    min-height: 64px;
    padding: 10px 22px;
    border-bottom: 1px solid var(--rule);
  }

  .queue-row i {
    width: 28px;
    aspect-ratio: 1;
    border: 1px solid var(--text);
    background: var(--surface);
  }

  .queue-row b {
    color: var(--muted);
    font-size: 10px;
  }

  .queue-row-active b {
    color: var(--brand-text);
  }

  .queue-summary {
    grid-template-columns: repeat(3, 1fr);
  }

  .queue-summary span {
    padding: 18px 22px;
  }

  .queue-summary span + span {
    border-left: 1px solid var(--rule);
  }

  .queue-summary small,
  .queue-summary strong {
    display: block;
  }

  .queue-summary small {
    color: var(--muted);
    font-size: 10px;
  }

  .batch-copy ul,
  .shopify-review ul {
    padding: 0;
    margin: 32px 0 0;
    list-style: none;
  }

  .batch-copy li {
    padding: 20px 0;
    border-top: 1px solid var(--rule);
  }

  .shopify-review {
    background: var(--surface);
  }

  .shopify-review aside {
    padding-left: 32px;
    border-left: 4px solid var(--brand);
  }

  .shopify-review aside li {
    margin-top: 8px;
  }

  .shopify-cta-layout {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  .shopify-cta h2 {
    max-width: 680px;
  }

  .shopify-cta .button-primary {
    min-width: 230px;
  }

  @media (max-width: 820px) {
    .shopify-spec-layout,
    .batch-layout,
    .review-layout,
    .shopify-cta-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .catalog-sheet dl > div {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .shopify-review aside {
      padding: 24px 0 0;
      border-top: 4px solid var(--brand);
      border-left: 0;
    }

    .shopify-cta .button-primary {
      width: 100%;
    }
  }

  @media (max-width: 560px) {
    .shopify-spec,
    .shopify-workflow,
    .shopify-batch,
    .shopify-review,
    .shopify-cta {
      padding: 64px 0;
    }

    .catalog-preview {
      grid-template-columns: 96px 1fr;
      padding: 18px;
    }

    .shopify-workflow li {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 16px;
    }

    .queue-row {
      grid-template-columns: 32px minmax(0, 1fr) auto;
      padding-inline: 14px;
      font-size: 13px;
    }

    .queue-summary span {
      padding: 14px;
    }
  }
</style>
