---
import type { ToolPageData } from '../../data/toolPages';

interface Props {
  page: Extract<ToolPageData, { kind: 'converter' }>;
}

const { page } = Astro.props;
const { content } = page;
---

<section class="converter-process" aria-labelledby="converter-process-title">
  <div class="container">
    <div class="converter-intro">
      <h2 id="converter-process-title">{content.conversionHeading}</h2>
    </div>

    <ol class="conversion-rail">
      {content.conversionSteps.map((step, index) => (
        <li>
          <div class="rail-marker">
            <span>{index === 0 ? 'PNG' : index === content.conversionSteps.length - 1 ? 'WebP' : `${index + 1}`}</span>
          </div>
          <div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="converter-modes" aria-labelledby="converter-modes-title">
  <div class="container mode-layout">
    <div class="mode-copy">
      <h2 id="converter-modes-title">{content.modesHeading}</h2>
      <p>{content.modesBody}</p>
    </div>

    <div class="mode-spec" role="list">
      {content.modes.map((mode, index) => (
        <article role="listitem">
          <span class="mode-index">0{index + 1}</span>
          <h3>{mode.title}</h3>
          <p>{mode.body}</p>
          <span class="mode-meter" aria-hidden="true"><i style={`--meter:${92 - index * 21}%`}></i></span>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="converter-output" aria-labelledby="converter-output-title">
  <div class="container">
    <div class="output-heading">
      <h2 id="converter-output-title">{content.comparisonHeading}</h2>
      <p>{content.comparisonBody}</p>
    </div>

    <div class="output-console" aria-label={content.comparisonHeading}>
      <div class="file-side file-side-source">
        <span class="file-type">PNG</span>
        <strong>100%</strong>
        <small>RGBA</small>
      </div>
      <div class="conversion-arrow" aria-hidden="true">
        <span></span>
        <b>→</b>
      </div>
      <div class="file-side file-side-result">
        <span class="file-type">WebP</span>
        <strong>≈ 62%</strong>
        <small>Alpha</small>
      </div>
    </div>

    <div class="converter-notes">
      <div class="batch-copy">
        <h3>{content.batchHeading}</h3>
        <p>{content.batchBody}</p>
      </div>
      <ul>
        {content.batchNotes.map((note) => <li><strong>{note.title}</strong><span>{note.body}</span></li>)}
      </ul>
    </div>

    <aside class="local-note">
      <div><h3>{content.localHeading}</h3><p>{content.localBody}</p></div>
      <ul>{content.localFacts.map((fact) => <li>{fact}</li>)}</ul>
    </aside>
  </div>
</section>

<style>
  .converter-process,
  .converter-modes,
  .converter-output {
    padding: 80px 0;
  }

  .converter-intro,
  .output-heading {
    max-width: 860px;
    margin-inline: auto;
  }

  .conversion-rail {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    margin: 52px 0 0;
    list-style: none;
  }

  .conversion-rail li {
    position: relative;
    min-width: 0;
    padding-right: 44px;
  }

  .conversion-rail li:not(:last-child)::after {
    position: absolute;
    top: 27px;
    right: 14px;
    left: 70px;
    height: 2px;
    background: var(--text);
    content: '';
  }

  .rail-marker {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    margin-bottom: 24px;
    border: 2px solid var(--text);
    background: #fff;
    font-size: 11px;
    font-weight: 900;
  }

  .conversion-rail h3,
  .mode-spec h3 {
    margin-bottom: 10px;
  }

  .conversion-rail p,
  .mode-copy p,
  .mode-spec p,
  .output-heading p,
  .batch-copy p,
  .local-note p {
    margin: 0;
    color: var(--muted);
  }

  .mode-layout {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
    gap: 88px;
    align-items: start;
  }

  .mode-copy {
    position: sticky;
    top: 32px;
  }

  .mode-spec article {
    display: grid;
    grid-template-columns: 38px minmax(150px, 0.7fr) minmax(0, 1.3fr);
    gap: 20px;
    padding: 24px 0;
    border-bottom: 1px solid var(--rule);
  }

  .mode-index {
    color: var(--brand-text);
    font-size: 12px;
    font-weight: 850;
  }

  .mode-meter {
    grid-column: 2 / -1;
    height: 6px;
    background: var(--surface);
  }

  .mode-meter i {
    display: block;
    width: var(--meter);
    height: 100%;
    background: var(--brand);
  }

  .output-console {
    display: grid;
    grid-template-columns: 1fr 120px 1fr;
    align-items: stretch;
    min-height: 250px;
    margin: 48px auto 0;
    border: 2px solid var(--text);
  }

  .file-side {
    display: grid;
    align-content: center;
    justify-items: center;
    padding: 32px;
  }

  .file-side-result {
    background-image: linear-gradient(45deg, var(--surface) 25%, transparent 25%), linear-gradient(-45deg, var(--surface) 25%, transparent 25%), linear-gradient(45deg, transparent 75%, var(--surface) 75%), linear-gradient(-45deg, transparent 75%, var(--surface) 75%);
    background-position: 0 0, 0 12px, 12px -12px, -12px 0;
    background-size: 24px 24px;
  }

  .file-type {
    margin-bottom: 18px;
    color: var(--brand-text);
    font-size: 12px;
    font-weight: 900;
  }

  .file-side strong {
    font-size: 40px;
    font-variant-numeric: tabular-nums;
  }

  .file-side small {
    margin-top: 8px;
    color: var(--muted);
  }

  .conversion-arrow {
    display: grid;
    place-items: center;
  }

  .conversion-arrow b {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    background: var(--brand);
    color: var(--on-brand);
    font-size: 24px;
  }

  .converter-notes {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.2fr);
    gap: 56px;
    margin-top: 48px;
  }

  .converter-notes ul,
  .local-note ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .converter-notes li {
    display: grid;
    gap: 6px;
    padding: 0 0 20px;
  }

  .converter-notes li span {
    color: var(--muted);
  }

  .local-note {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 48px;
    margin-top: 64px;
    padding: 28px 0 0 24px;
    border-left: 4px solid var(--brand);
  }

  .local-note li + li {
    margin-top: 8px;
  }

  @media (max-width: 760px) {
    .converter-process,
    .converter-modes,
    .converter-output {
      padding: 64px 0;
    }

    .conversion-rail,
    .mode-layout,
    .converter-notes,
    .local-note {
      grid-template-columns: 1fr;
    }

    .conversion-rail {
      gap: 32px;
    }

    .conversion-rail li {
      display: grid;
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 18px;
      padding: 0;
    }

    .conversion-rail li::after {
      display: none;
    }

    .rail-marker {
      margin: 0;
    }

    .mode-layout {
      gap: 36px;
    }

    .mode-copy {
      position: static;
    }

    .mode-spec article {
      grid-template-columns: 30px minmax(0, 1fr);
    }

    .mode-spec article p,
    .mode-meter {
      grid-column: 2;
    }

    .output-console {
      grid-template-columns: 1fr;
    }

    .conversion-arrow {
      min-height: 72px;
    }

    .conversion-arrow b {
      transform: rotate(90deg);
    }

    .converter-notes,
    .local-note {
      gap: 28px;
    }
  }
</style>
