---
import { devToolCatalog } from '../data/devToolCatalog';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'All Tools - Vicoco 开发索引';
const description = 'Vicoco SEO 页面开发索引。';
---

<BaseLayout
  {title}
  {description}
  lang="zh-CN"
  robots="noindex, nofollow"
  skipLinkLabel="跳到页面列表"
>
  <header class="tools-header">
    <div class="container tools-brand">
      <img src={`${import.meta.env.BASE_URL}assets/vicoco-logo.svg`} width="34" height="34" alt="" />
      <span>Vicoco</span>
      <small>Development</small>
    </div>
  </header>

  <main id="main-content" class="tools-main">
    <div class="container">
      <div class="tools-heading">
        <h1>All Tools</h1>
        <p>{devToolCatalog.length} 个本仓库页面</p>
      </div>

      <div class="tools-table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">页面</th>
              <th scope="col">中文说明</th>
              <th scope="col">语言</th>
              <th scope="col">路径</th>
            </tr>
          </thead>
          <tbody>
            {devToolCatalog.map((tool) => (
              <tr>
                <td><a href={tool.path}>{tool.title}</a></td>
                <td>{tool.explanation}</td>
                <td>{tool.language}</td>
                <td><code>{tool.path}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .tools-header {
    border-bottom: 1px solid var(--rule);
  }

  .tools-brand {
    min-height: 72px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 850;
  }

  .tools-brand small {
    margin-left: 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
  }

  .tools-main {
    padding: 64px 0 96px;
  }

  .tools-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
  }

  .tools-heading h1 {
    margin: 0;
    font-size: 48px;
  }

  .tools-heading p {
    margin: 0;
    color: var(--muted);
  }

  .tools-table-wrap {
    overflow-x: auto;
    border-top: 2px solid var(--text);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  th,
  td {
    padding: 18px 16px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  th:first-child,
  td:first-child {
    padding-left: 0;
  }

  th:last-child,
  td:last-child {
    padding-right: 0;
  }

  th {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
  }

  td:first-child {
    width: 34%;
    font-weight: 800;
  }

  td:nth-child(2) {
    width: 28%;
  }

  td:nth-child(3) {
    white-space: nowrap;
  }

  td code {
    font-size: 12px;
    overflow-wrap: anywhere;
  }

  td a {
    color: var(--brand-text);
    text-underline-offset: 4px;
  }

  tbody tr:hover {
    background: var(--surface);
  }

  @media (max-width: 760px) {
    .tools-main {
      padding: 48px 0 72px;
    }

    .tools-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .tools-heading h1 {
      font-size: 38px;
    }

    table {
      min-width: 760px;
    }
  }
</style>
