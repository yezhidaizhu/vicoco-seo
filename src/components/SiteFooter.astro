---
interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  relatedLinks?: FooterLink[];
}

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const { relatedLinks = [] } = Astro.props;
const toolLinks = [
  { label: 'Free Image Compressor', href: 'https://vicoco.uk/' },
  ...relatedLinks,
];
---

<footer class="site-footer">
  <svg
    class="footer-wave"
    viewBox="0 0 1440 88"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path d="M0 54C238 87 430 13 716 46c282 33 477-25 724 8v34H0Z"></path>
  </svg>
  <div class="container footer-main">
    <div class="footer-brand-block">
      <a class="brand" href="https://vicoco.uk/" aria-label="Vicoco home">
        <img src={`${base}assets/vicoco-logo.svg`} width="58" height="58" alt="" />
        <span>Vicoco</span>
      </a>
    </div>
    <div class="footer-groups">
      <div class="footer-group">
        <p class="footer-group-title">Related tools</p>
        <nav class="footer-nav" aria-label="Related tools">
          {toolLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
      <div class="footer-group">
        <p class="footer-group-title">Vicoco</p>
        <nav class="footer-nav" aria-label="Vicoco links">
          <a href="https://github.com/yezhidaizhu/web-squoosh-batchlet#privacy">Privacy</a>
          <a href="https://github.com/yezhidaizhu/web-squoosh-batchlet">GitHub</a>
        </nav>
      </div>
    </div>
  </div>
  <div class="container footer-meta">
    <span>&copy; {year} Vicoco</span>
  </div>
</footer>
