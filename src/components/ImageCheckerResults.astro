<section
  class="checker-results"
  data-checker-results
  hidden
  aria-labelledby="checker-results-title"
>
  <div class="container checker-results-inner">
    <header class="checker-results-header">
      <div>
        <h2 id="checker-results-title">Image details</h2>
        <p data-checker-summary role="status" aria-live="polite"></p>
      </div>
      <div class="checker-results-actions">
        <button class="checker-action" data-choose-images type="button">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12h14"></path>
          </svg>
          Add images
        </button>
        <button
          class="checker-icon-action"
          data-checker-clear
          type="button"
          aria-label="Clear all images"
          title="Clear all images"
          disabled
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 10v6M14 10v6"></path>
          </svg>
        </button>
        <button
          class="button-primary checker-compress"
          data-checker-compress
          type="button"
          disabled
        >
          To compress
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </button>
      </div>
    </header>
    <div class="checker-results-list" data-checker-list></div>
  </div>
</section>

<script>
  const DATABASE_NAME = 'vicoco-handoff';
  const STORE_NAME = 'transfers';
  const TRANSFER_TTL = 60 * 60 * 1000;

  interface CheckedFile {
    id: string;
    file: File;
    previewUrl: string;
    element: HTMLElement;
  }

  const results = document.querySelector<HTMLElement>('[data-checker-results]');
  const list = results?.querySelector<HTMLElement>('[data-checker-list]');
  const summary = results?.querySelector<HTMLElement>('[data-checker-summary]');
  const clearButton = results?.querySelector<HTMLButtonElement>('[data-checker-clear]');
  const compressButton = results?.querySelector<HTMLButtonElement>('[data-checker-compress]');
  const uploader = document.querySelector<HTMLElement>('[data-uploader]');
  const defaultStatus = uploader?.querySelector<HTMLElement>('[data-status]')?.textContent || '';
  const labels = {
    preparing: uploader?.dataset.preparing || 'Preparing',
    imageSingular: uploader?.dataset.imageSingular || 'image',
    imagePlural: uploader?.dataset.imagePlural || 'images',
    editorError: uploader?.dataset.editorError || 'Could not open the editor. Please try again.',
  };
  let nextId = 0;
  let checkedFiles: CheckedFile[] = [];
  let busy = false;

  const setUploadStatus = (
    message: string,
    state: 'idle' | 'busy' | 'error' = 'idle',
  ) => {
    window.dispatchEvent(
      new CustomEvent('vicoco:checker-status', { detail: { message, state } }),
    );
  };

  const setBusy = (value: boolean) => {
    busy = value;
    if (clearButton) clearButton.disabled = value || checkedFiles.length === 0;
    if (compressButton) compressButton.disabled = value || checkedFiles.length === 0;
    list?.querySelectorAll<HTMLButtonElement>('.checker-remove').forEach((button) => {
      button.disabled = value;
    });
  };

  const transactionDone = (transaction: IDBTransaction) =>
    new Promise<void>((resolve, reject) => {
      transaction.oncomplete = () => resolve();
      transaction.onerror = () => reject(transaction.error);
      transaction.onabort = () => reject(transaction.error);
    });

  const openDatabase = () =>
    new Promise<IDBDatabase>((resolve, reject) => {
      const request = indexedDB.open(DATABASE_NAME, 1);
      request.onupgradeneeded = () => {
        if (!request.result.objectStoreNames.contains(STORE_NAME)) {
          request.result.createObjectStore(STORE_NAME);
        }
      };
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });

  const saveTransfer = async (files: File[]) => {
    const database = await openDatabase();
    try {
      const id = crypto.randomUUID();
      const transaction = database.transaction(STORE_NAME, 'readwrite');
      const store = transaction.objectStore(STORE_NAME);
      const expiresBefore = Date.now() - TRANSFER_TTL;
      const cursorRequest = store.openCursor();
      cursorRequest.onsuccess = () => {
        const cursor = cursorRequest.result;
        if (!cursor) return;
        const value = cursor.value as { createdAt?: number };
        if (!value.createdAt || value.createdAt < expiresBefore) cursor.delete();
        cursor.continue();
      };
      store.put({ createdAt: Date.now(), files }, id);
      await transactionDone(transaction);
      return id;
    } finally {
      database.close();
    }
  };

  const formatBytes = (bytes: number) => {
    if (bytes < 1024) return `${bytes} B`;
    const units = ['KB', 'MB', 'GB'];
    let value = bytes / 1024;
    let unit = units[0];
    for (let index = 1; index < units.length && value >= 1024; index += 1) {
      value /= 1024;
      unit = units[index];
    }
    return `${value >= 10 ? value.toFixed(1) : value.toFixed(2)} ${unit}`;
  };

  const greatestCommonDivisor = (a: number, b: number): number =>
    b ? greatestCommonDivisor(b, a % b) : a;

  const sniffFormat = async (file: File) => {
    const bytes = new Uint8Array(await file.slice(0, 16).arrayBuffer());
    const text = (start: number, end: number) =>
      String.fromCharCode(...bytes.slice(start, end));
    if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'JPEG';
    if (
      bytes[0] === 0x89 &&
      bytes[1] === 0x50 &&
      bytes[2] === 0x4e &&
      bytes[3] === 0x47 &&
      bytes[4] === 0x0d &&
      bytes[5] === 0x0a &&
      bytes[6] === 0x1a &&
      bytes[7] === 0x0a
    ) return 'PNG';
    if (text(0, 3) === 'GIF') return 'GIF';
    if (text(0, 4) === 'RIFF' && text(8, 12) === 'WEBP') return 'WebP';
    if (text(4, 8) === 'ftyp' && /avi[fs]/i.test(text(8, 16))) return 'AVIF';
    if (file.type === 'image/svg+xml' || /\.svg$/i.test(file.name)) return 'SVG';
    const mimeLabels: Record<string, string> = {
      'image/avif': 'AVIF',
      'image/gif': 'GIF',
      'image/jpeg': 'JPEG',
      'image/png': 'PNG',
      'image/webp': 'WebP',
    };
    return mimeLabels[file.type] || file.type.split('/')[1]?.toUpperCase() || 'Unknown';
  };

  const imageDimensions = async (file: File, url: string) => {
    if ('createImageBitmap' in window) {
      try {
        const bitmap = await createImageBitmap(file);
        const dimensions = { width: bitmap.width, height: bitmap.height };
        bitmap.close();
        return dimensions;
      } catch (_) {}
    }
    return new Promise<{ width: number; height: number }>((resolve, reject) => {
      const image = new Image();
      image.onload = () => resolve({ width: image.naturalWidth, height: image.naturalHeight });
      image.onerror = () => reject(Error('Could not read image dimensions'));
      image.src = url;
    });
  };

  const metric = (label: string, value: string) => {
    const item = document.createElement('div');
    const term = document.createElement('dt');
    const detail = document.createElement('dd');
    term.textContent = label;
    detail.textContent = value;
    item.append(term, detail);
    return { item, detail };
  };

  const updateSummary = () => {
    const count = checkedFiles.length;
    if (results) results.hidden = count === 0;
    if (summary) summary.textContent = `${count} ${count === 1 ? 'image' : 'images'} inspected`;
    setBusy(busy);
  };

  const removeFile = (id: string) => {
    const checkedFile = checkedFiles.find((item) => item.id === id);
    if (!checkedFile) return;
    URL.revokeObjectURL(checkedFile.previewUrl);
    checkedFile.element.remove();
    checkedFiles = checkedFiles.filter((item) => item.id !== id);
    updateSummary();
    setUploadStatus(
      checkedFiles.length
        ? `${checkedFiles.length} ${
            checkedFiles.length === 1 ? labels.imageSingular : labels.imagePlural
          } inspected`
        : defaultStatus,
    );
  };

  const renderFile = async (file: File) => {
    if (!list) return;
    const id = `checked-image-${nextId++}`;
    const previewUrl = URL.createObjectURL(file);
    const article = document.createElement('article');
    article.className = 'checker-result-item';

    const preview = document.createElement('div');
    preview.className = 'checker-result-preview';
    const image = document.createElement('img');
    image.src = previewUrl;
    image.alt = '';
    preview.append(image);

    const details = document.createElement('div');
    details.className = 'checker-result-details';
    const titleRow = document.createElement('div');
    titleRow.className = 'checker-result-title';
    const heading = document.createElement('h3');
    heading.textContent = file.name;
    const removeButton = document.createElement('button');
    removeButton.type = 'button';
    removeButton.className = 'checker-remove';
    removeButton.setAttribute('aria-label', `Remove ${file.name}`);
    removeButton.title = 'Remove image';
    removeButton.disabled = busy;
    removeButton.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>';
    removeButton.addEventListener('click', () => removeFile(id));
    titleRow.append(heading, removeButton);

    const metrics = document.createElement('dl');
    const formatMetric = metric('Format', 'Reading...');
    const sizeMetric = metric('File size', formatBytes(file.size));
    const dimensionsMetric = metric('Dimensions', 'Reading...');
    const ratioMetric = metric('Aspect ratio', 'Reading...');
    metrics.append(
      formatMetric.item,
      sizeMetric.item,
      dimensionsMetric.item,
      ratioMetric.item,
    );
    details.append(titleRow, metrics);
    article.append(preview, details);
    list.append(article);
    checkedFiles.push({ id, file, previewUrl, element: article });

    formatMetric.detail.textContent = await sniffFormat(file);
    try {
      const dimensions = await imageDimensions(file, previewUrl);
      const divisor = greatestCommonDivisor(dimensions.width, dimensions.height);
      dimensionsMetric.detail.textContent = `${dimensions.width} × ${dimensions.height} px`;
      ratioMetric.detail.textContent = `${dimensions.width / divisor}:${dimensions.height / divisor}`;
    } catch (_) {
      dimensionsMetric.detail.textContent = 'Unavailable';
      ratioMetric.detail.textContent = 'Unavailable';
    }
  };

  const inspectFiles = async (files: File[]) => {
    const fingerprints = new Set(
      checkedFiles.map(({ file }) => `${file.name}:${file.size}:${file.lastModified}:${file.type}`),
    );
    const additions = files.filter((file) => {
      const fingerprint = `${file.name}:${file.size}:${file.lastModified}:${file.type}`;
      if (fingerprints.has(fingerprint)) return false;
      fingerprints.add(fingerprint);
      return true;
    });
    if (additions.length === 0) {
      setUploadStatus('These images are already listed.');
      return;
    }
    setBusy(true);
    setUploadStatus(
      `${labels.preparing} ${additions.length} ${
        additions.length === 1 ? labels.imageSingular : labels.imagePlural
      }...`,
      'busy',
    );
    if (results) results.hidden = false;
    await Promise.allSettled(additions.map(renderFile));
    setBusy(false);
    updateSummary();
    setUploadStatus(`${checkedFiles.length} ${checkedFiles.length === 1 ? labels.imageSingular : labels.imagePlural} inspected`);
    results?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  const compressAll = async () => {
    if (checkedFiles.length === 0) return;
    const files = checkedFiles.map(({ file }) => file);
    setBusy(true);
    setUploadStatus(
      `${labels.preparing} ${files.length} ${
        files.length === 1 ? labels.imageSingular : labels.imagePlural
      }...`,
      'busy',
    );
    try {
      const id = await saveTransfer(files);
      const destination = new URL('/handoff', window.location.origin);
      destination.searchParams.set('handoff', id);
      destination.searchParams.set('source', 'image-size-checker');
      window.location.assign(destination);
    } catch (error) {
      console.error(error);
      setBusy(false);
      setUploadStatus(labels.editorError, 'error');
    }
  };

  window.addEventListener('vicoco:checker-files', (event) => {
    const files = (event as CustomEvent<{ files: File[] }>).detail.files;
    void inspectFiles(files);
  });
  clearButton?.addEventListener('click', () => {
    checkedFiles.forEach(({ previewUrl, element }) => {
      URL.revokeObjectURL(previewUrl);
      element.remove();
    });
    checkedFiles = [];
    updateSummary();
    setUploadStatus(defaultStatus);
  });
  compressButton?.addEventListener('click', () => void compressAll());
  window.addEventListener('pagehide', () => {
    checkedFiles.forEach(({ previewUrl }) => URL.revokeObjectURL(previewUrl));
  });
</script>

<style>
  .checker-results[hidden] {
    display: none;
  }

  .checker-results {
    scroll-margin-top: 24px;
    padding: 8px 0 72px;
  }

  .checker-results-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 16px;
  }

  .checker-results-eyebrow {
    margin: 0 0 8px;
    color: var(--brand-text);
    font-size: 12px;
    font-weight: 850;
    text-transform: uppercase;
  }

  .checker-results-header h2 {
    margin-bottom: 8px;
    font-size: 32px;
  }

  .checker-results-header p:last-child {
    margin: 0;
    color: var(--muted);
  }

  .checker-results-actions {
    display: flex;
    flex: 0 0 auto;
    gap: 8px;
    align-items: center;
  }

  .checker-action,
  .checker-icon-action,
  :global(.checker-remove) {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 800;
  }

  .checker-action {
    gap: 8px;
    padding: 0 14px;
  }

  .checker-icon-action,
  :global(.checker-remove) {
    width: 44px;
    padding: 0;
  }

  .checker-action:hover,
  .checker-icon-action:hover,
  :global(.checker-remove:hover) {
    border-color: var(--text);
    background: var(--surface);
  }

  .checker-action:disabled,
  .checker-icon-action:disabled,
  .checker-compress:disabled,
  :global(.checker-remove:disabled) {
    cursor: wait;
    opacity: 0.55;
  }

  .checker-action svg,
  .checker-icon-action svg,
  :global(.checker-remove svg) {
    width: 19px;
    height: 19px;
  }

  .checker-compress {
    min-height: 44px;
  }

  .checker-results-list {
    border-top: 2px solid var(--text);
  }

  :global(.checker-result-item) {
    display: grid;
    grid-template-columns: minmax(180px, 300px) minmax(0, 1fr);
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }

  :global(.checker-result-preview) {
    min-height: 180px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--surface);
  }

  :global(.checker-result-preview img) {
    width: 100%;
    height: 210px;
    object-fit: contain;
  }

  :global(.checker-result-title) {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  :global(.checker-result-title h3) {
    min-width: 0;
    margin: 9px 0 0;
    overflow-wrap: anywhere;
    font-size: 20px;
  }

  :global(.checker-result-details dl) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 32px;
    margin: 0;
  }

  :global(.checker-result-details dt) {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  :global(.checker-result-details dd) {
    margin: 5px 0 0;
    font-size: 17px;
    font-weight: 850;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 760px) {
    .checker-results-header {
      display: block;
    }

    .checker-results-actions {
      margin-top: 20px;
    }

    :global(.checker-result-item) {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    :global(.checker-result-preview img) {
      height: 230px;
    }
  }

  @media (max-width: 520px) {
    .checker-results-actions {
      display: grid;
      grid-template-columns: 1fr 44px;
    }

    .checker-action {
      width: 100%;
    }

    .checker-compress {
      grid-column: 1 / -1;
      width: 100%;
    }
  }
</style>
