---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Vicoco"
  description="The requested Vicoco page could not be found."
  robots="noindex, nofollow"
>
  <main id="main-content" class="not-found-page">
    <section class="not-found-section" aria-labelledby="not-found-title">
      <div class="container not-found-layout">
        <p class="not-found-code" aria-hidden="true">404</p>
        <div class="not-found-copy">
          <h1 id="not-found-title">Page not found</h1>
          <p>The page may have moved, or the address may be incorrect.</p>
          <div class="not-found-actions">
            <a class="button-primary" href="/">Back to home</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
